# Speech-To-Text Configuration
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Hugging Face LLM Configuration
# Modes: transformers_local | huggingface_api
LLM_BACKEND=transformers_local
HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Device for local PyTorch execution: auto | mps | cuda | cpu
DEVICE=auto

# Optional Hugging Face Access Token (Required for gated models like Llama or HF Serverless API)
HF_TOKEN=
